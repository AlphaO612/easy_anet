# syntax=docker/dockerfile:1
ARG RUST_DIGEST=sha256:f17e723020f87c1b4ac4ff6d73c9dfbb7d5cb978754c76641e47337d65f61e12
ARG RUNTIME_IMAGE=docker.io/chainguard/glibc-dynamic
ARG RUNTIME_DIGEST=sha256:3359c6ba6b3bcf3b1d2179849f782365564cb262789e732e2833b25b9a8c00f1
FROM docker.io/library/rust:1.94.0-trixie@${RUST_DIGEST} AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang cmake golang-go libclang-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_BUILD_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1
WORKDIR /src
COPY . .
ARG TARGETARCH
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=anet-release-1.94-${TARGETARCH},target=/src/target,sharing=locked \
    cargo build --locked --release -p anet-server --no-default-features \
    && install -Dm0555 target/release/anet-server /out/anet-server \
    && strip /out/anet-server

# A dedicated network namespace contains the TUN created by this server.
# This checks local interface creation; end-to-end traffic is tested separately.
RUN <<'BUILD_PROBE'
set -eu
cat >/tmp/tun-health.rs <<'RUST'
use std::{fs, process::ExitCode};

fn main() -> ExitCode {
    let Ok(interfaces) = fs::read_dir("/sys/class/net") else {
        return ExitCode::FAILURE;
    };
    let found = interfaces.flatten().any(|interface| {
        let Ok(flags) = fs::read_to_string(interface.path().join("tun_flags")) else {
            return false;
        };
        u32::from_str_radix(flags.trim().trim_start_matches("0x"), 16)
            .is_ok_and(|value| value & 1 != 0)
    });
    if found { ExitCode::SUCCESS } else { ExitCode::FAILURE }
}
RUST
rustc -C opt-level=s -C strip=symbols /tmp/tun-health.rs -o /out/tun-health
BUILD_PROBE

FROM ${RUNTIME_IMAGE}@${RUNTIME_DIGEST}
COPY --from=build --chown=0:0 --chmod=0555 /out/ /usr/local/bin/
USER 65532:65532
RUN ["/usr/local/bin/anet-server", "--help"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s CMD ["/usr/local/bin/tun-health"]
ENTRYPOINT ["/usr/local/bin/anet-server"]
CMD ["--cfg", "/etc/anet/server.toml"]
