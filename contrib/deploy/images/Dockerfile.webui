# syntax=docker/dockerfile:1
FROM docker.io/library/rust:1.94.0-trixie@sha256:f17e723020f87c1b4ac4ff6d73c9dfbb7d5cb978754c76641e47337d65f61e12 AS probe
COPY contrib/deploy/images/http-health.rs /tmp/
RUN rustc -C target-feature=+crt-static -C opt-level=s -C strip=symbols /tmp/http-health.rs -o /tmp/http-health

FROM docker.io/library/node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS build
WORKDIR /src
COPY anet-webui/package*.json ./
RUN npm ci
COPY anet-webui/ .
ARG VITE_ANET_GRAFANA_URL
RUN npm run build

FROM docker.io/chainguard/nginx@sha256:c1642395cc75f39c931d66d939f7e78cbdf671d6cfd821616632b0639c3c6d63
COPY --from=build /src/dist/ /usr/share/nginx/html/
COPY --from=probe --chmod=0555 /tmp/http-health /usr/local/bin/
COPY contrib/deploy/images/nginx.conf /etc/nginx/nginx.conf
USER 65532:65532
HEALTHCHECK --interval=15s --timeout=3s CMD ["/usr/local/bin/http-health","127.0.0.1:8080","/"]
ENTRYPOINT ["/usr/sbin/nginx"]
CMD ["-g","daemon off;"]
