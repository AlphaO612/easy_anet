# syntax=docker/dockerfile:1
FROM docker.io/library/rust:1.94.0-trixie@sha256:f17e723020f87c1b4ac4ff6d73c9dfbb7d5cb978754c76641e47337d65f61e12 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang cmake golang-go libclang-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_BUILD_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1
WORKDIR /src
COPY . .
ARG TARGETARCH
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=anet-release-1.94-${TARGETARCH},target=/src/target,sharing=locked \
    cargo build --locked --release -p anet-auth && install -Dm0555 target/release/anet-auth /out/anet-auth && strip /out/anet-auth
RUN rustc -C opt-level=s -C strip=symbols contrib/deploy/images/http-health.rs -o /tmp/http-health

FROM docker.io/chainguard/glibc-dynamic@sha256:3359c6ba6b3bcf3b1d2179849f782365564cb262789e732e2833b25b9a8c00f1
WORKDIR /opt/anet
COPY --from=build --chmod=0555 /out/anet-auth /usr/local/bin/anet-auth
COPY --from=build --chmod=0555 /tmp/http-health /usr/local/bin/http-health
COPY --chmod=0444 contrib/client_template.toml .
USER 65532:65532
HEALTHCHECK --interval=15s --timeout=3s CMD ["/usr/local/bin/http-health","127.0.0.1:3000","/spec"]
ENTRYPOINT ["/usr/local/bin/anet-auth"]
